TITLE=Banking Agent Foundry Orchestrator

# Region used by the Terraform stack in infrastructure/ (the only Terraform input).
DEFAULT_REGION=swedencentral

# Subscription and optional Azure Blob backend used by Task and both Terraform stacks.
# Leave the TF_BACKEND_* values blank to use local Terraform state for a simple
# developer workflow. If you do want remote state, set all four values and use a
# globally unique storage account name.
AZURE_SUBSCRIPTION_ID=
TF_BACKEND_RESOURCE_GROUP=
TF_BACKEND_STORAGE_ACCOUNT=
TF_BACKEND_CONTAINER=
TF_STATE_ENVIRONMENT=

# --- Foundry Hosted Agent invocation (orchestrator) ---------------------------
# In Azure these are injected by Terraform onto the orchestrator container app.
# Locally, leave them blank to exercise FoundryMcpClient's local-fallback path,
# or point them at a real Foundry project you can reach with `az login`.
# FOUNDRY_AGENT_ENDPOINT is the Foundry *project* endpoint, e.g.
#   https://<foundry-account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_SCOPE=https://ai.azure.com/.default
# Optional JSON map of tool name -> endpoint, e.g.
# {"workflow.plan":"http://localhost:8000/plan","workflow.reason":"http://localhost:8000/reason"}
FOUNDRY_TOOL_ENDPOINTS=

# --- Web UI -------------------------------------------------------------------
# Base URL of the orchestrator API. Terraform sets this to the orchestrator's
# public FQDN in Azure; locally it is the dotnet dev server.
ORCHESTRATOR_API_BASE_URL=http://localhost:5000

# --- LiteLLM gateway (Python agents) ------------------------------------------
# Cloud-provisioned: Terraform points this at the LiteLLM container app's
# internal FQDN. Set it by hand only if you run LiteLLM locally.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=gpt-4o-mini

# --- Persistence ---------------------------------------------------------------
# Azure Database for PostgreSQL settings are injected by Terraform in Azure.
# Runtime authentication uses managed identity; do not add a database password.

# --- Observability -------------------------------------------------------------
# Injected by Terraform in Azure; optional locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=

TITLE=Banking Agent Foundry Orchestrator

# Region used by the Terraform stack in infrastructure/ (the only Terraform input).
DEFAULT_REGION=swedencentral

# Subscription and optional Azure Blob backend used by Task and both Terraform stacks.
# Leave the TF_BACKEND_* values blank to use local Terraform state for a simple
# developer workflow. If you do want remote state, set all four values and use a
# globally unique storage account name.
AZURE_SUBSCRIPTION_ID=
TF_BACKEND_RESOURCE_GROUP=
TF_BACKEND_STORAGE_ACCOUNT=
TF_BACKEND_CONTAINER=
TF_STATE_ENVIRONMENT=

# --- Foundry Hosted Agent invocation (orchestrator) ---------------------------
# In Azure these are injected by Terraform onto the orchestrator container app.
# Locally, leave them blank to exercise FoundryMcpClient's local-fallback path,
# or point them at a real Foundry project you can reach with `az login`.
# FOUNDRY_AGENT_ENDPOINT is the Foundry *project* endpoint, e.g.
#   https://<foundry-account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_SCOPE=https://ai.azure.com/.default
# Optional JSON map of tool name -> endpoint, e.g.
# {"workflow.plan":"http://localhost:8000/plan","workflow.reason":"http://localhost:8000/reason"}
FOUNDRY_TOOL_ENDPOINTS=

# --- Service authentication ----------------------------------------------------
# Service authentication is on by default and requires an Entra app registration
# with a service principal and an api:// identifier URI for the orchestrator API.
#
# Some tenants forbid creating those objects. Terraform then fails with
# "403 Authorization_RequestDenied", leaving the deployment half-applied. If that
# is your tenant, set both values below: the first turns service authentication
# off, the second acknowledges the consequence.
#
# With these set, anyone who can reach the orchestrator ingress can start and
# approve workflows. Use only for demo and lab environments, never for real or
# regulated data. Readiness reports service_auth as Degraded so the state of the
# system stays honest.
#
# Both must be set together. Setting only ENABLE_SERVICE_AUTH=false fails the
# Terraform plan and the orchestrator refuses to start.
# ENABLE_SERVICE_AUTH=false
# ALLOW_INSECURE_SERVICE_AUTH=true

# --- Optional agent features ---------------------------------------------------
# Both are off by default. Setting them here applies to every `task app:apply`
# and `task app:deploy`; an inline environment variable still overrides the file,
# e.g. `ENABLE_AGENT_MEMORY=false task app:apply -- swedencentral`.
#
# ENABLE_AGENT_MEMORY deploys the customer-profile prompt agent with a Foundry
# memory store attached. Memory is a preview feature that retains model-extracted
# customer detail, so leave it off unless you intend to demonstrate it.
#
# ENABLE_AGENT_TOOLBOX creates the shared Foundry toolbox and lets agents call its
# tools. The baseline agents run without tool access.
#
# After changing either value, re-run `task app:deploy-hosted-agents` so the new
# configuration reaches Foundry.
# ENABLE_AGENT_MEMORY=true
# ENABLE_AGENT_TOOLBOX=true

# --- Web UI -------------------------------------------------------------------
# Base URL of the orchestrator API. Terraform sets this to the orchestrator's
# public FQDN in Azure; locally it is the dotnet dev server.
ORCHESTRATOR_API_BASE_URL=http://localhost:5000

# --- Persistence ---------------------------------------------------------------
# Azure Database for PostgreSQL settings are injected by Terraform in Azure.
# Runtime authentication uses managed identity; do not add a database password.

# --- Observability -------------------------------------------------------------
# Injected by Terraform in Azure; optional locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=

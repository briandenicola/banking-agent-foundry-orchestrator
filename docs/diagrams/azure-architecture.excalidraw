      "id": "txt38",
      "type": "text",
      "x": 620,
      "y": 500,
      "width": 484.87999999999994,
      "height": 27.5,
      "strokeColor": "#5f6b7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "The Web UI holds ASP.NET Data Protection keys in container-local storage, so\nreplacing its single replica invalidates existing antiforgery cookies.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Web UI holds ASP.NET Data Protection keys in container-local storage, so\nreplacing its single replica invalidates existing antiforgery cookies.",
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null
    },

      "id": "txt104",
      "type": "text",
      "x": 1248,
      "y": 1004,
      "width": 612.4799999999999,
      "height": 68.75,
      "strokeColor": "#5f6b7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Holds the two container apps, the two jobs, three managed identities, and every role assignment.\nSeparating it from the shared group means the whole workload can be destroyed and re-applied\nwithout touching Foundry, the registry, the database, or the monitoring workspace.\n`scripts/guard-stack-alignment.sh` refuses to apply if the two stacks disagree about which\nenvironment they target.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Holds the two container apps, the two jobs, three managed identities, and every role assignment.\nSeparating it from the shared group means the whole workload can be destroyed and re-applied\nwithout touching Foundry, the registry, the database, or the monitoring workspace.\n`scripts/guard-stack-alignment.sh` refuses to apply if the two stacks disagree about which\nenvironment they target.",
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null
    },

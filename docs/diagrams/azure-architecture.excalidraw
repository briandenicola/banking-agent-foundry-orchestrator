      "type": "text",
      "x": 620,
      "y": 455,
      "width": 484.87999999999994,
      "height": 27.5,
      "strokeColor": "#5f6b7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Both apps run the same commit-tagged image set. revision_mode = Single, so a\nrollback is a Terraform apply with a previous immutable tag.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Both apps run the same commit-tagged image set. revision_mode = Single, so a\nrollback is a Terraform apply with a previous immutable tag.",
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null
    },
    {
      "angle": 0,
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 843100672,
      "version": 1,
      "versionNonce": 638462042,
      "isDeleted": false,

      "strokeColor": "#5f6b7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Python LangGraph graphs behind an MCP boundary: the orchestrator runs `initialize`, discovers with\n`tools/list`, and invokes with `tools/call`. Each registration gets its own instance identity, which\n`scripts/deploy-hosted-agents.sh` grants Cognitive Services OpenAI User after the job succeeds.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Python LangGraph graphs behind an MCP boundary: the orchestrator runs `initialize`, discovers with\n`tools/list`, and invokes with `tools/call`. Each registration gets its own instance identity, which\n`scripts/deploy-hosted-agents.sh` grants Cognitive Services OpenAI User after the job succeeds.",
      "autoResize": true,
      "lineHeight": 1.25,
      "roundness": null
    },

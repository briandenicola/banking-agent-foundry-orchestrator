      "width": 324.79999999999995,
      "height": 50.0,
      "strokeColor": "#5f6b7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Local auth is disabled, so Entra ID is the only way in.\nallowProjectManagement = true lets the deployer job\ncreate and version agents. Reached from the orchestrator\nover MCP/HTTPS using its user-assigned managed identity.",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",

@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="hero">
    <div>
        <span class="eyebrow">Request interrupted</span>
        <h1>We couldn’t finish that request.</h1>
        <p>Return to the workflow workspace and try again. Existing workflows remain available by their workflow ID.</p>
        <a asp-page="/Index" class="primary-action" style="max-width: 220px; margin-top: 28px; text-decoration: none;">
            <span>Return to workspace</span><span>→</span>
        </a>
        @if (Model.ShowRequestId)
        {
            <p style="margin-top: 22px; font-size: .75rem;">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</section>

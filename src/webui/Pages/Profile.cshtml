@page
@model webui.Pages.ProfileModel
@{
    ViewData["Title"] = "Customer profile agent";
}

@* Antiforgery token for the two POST handlers on this page. *@
@Html.AntiForgeryToken()

<div id="profile-notice" class="notice notice-error" role="alert" hidden>
    <span class="notice-icon">!</span>
    <span id="profile-notice-text"></span>
</div>

<div class="profile-grid">
    <section class="surface request-panel">
        <div class="section-heading">
            <div>
                <span class="step-label">Foundry prompt agent</span>
                <h2>Customer profile agent</h2>
            </div>
            <span class="live-indicator"><span></span> Memory enabled</span>
        </div>

        <p class="panel-intro">
            There is no container and no graph behind this one. Foundry runs the model
            loop and decides on its own when to search memory, when to write memory,
            and when to execute Python. The whole agent is a model, an instruction,
            and a tool list.
        </p>
        <p class="panel-intro">
            Every message is an independent request with <strong>no conversation
            history</strong>, so anything recalled came out of the memory store rather
            than the prompt.
        </p>

        <div class="scenario-heading">
            <span>Guided demonstration</span>
            <a href="#" id="profile-clear">Clear all memories</a>
        </div>
        <div class="scenario-grid" aria-label="Demonstration steps">
            @foreach (var prompt in webui.Pages.ProfileModel.Prompts)
            {
                <button type="button" class="scenario-card" data-prompt="@prompt.Text"
                        aria-pressed="false">
                    <strong>@prompt.Label</strong>
                    <small>@prompt.Description</small>
                    <span>@prompt.Expectation</span>
                </button>
            }
        </div>

        <label for="profile-message" class="form-label">Message to the agent</label>
        <textarea id="profile-message" class="form-control request-input" rows="4"
                  placeholder="Say something to the agent, or choose a step above."></textarea>

        <button type="button" id="profile-send" class="primary-action">
            <span>Send to the agent</span>
            <span aria-hidden="true">&#8594;</span>
        </button>
        <p class="submit-hint" id="profile-status" role="status" aria-live="polite">
            Memory extraction runs after each reply, so this is slower than a plain chat.
        </p>
    </section>

    <div class="profile-results">
        <section class="surface timeline-card" id="reply-panel" hidden>
            <div class="section-heading compact">
                <div>
                    <span class="step-label">Response</span>
                    <h3>What the agent said</h3>
                </div>
            </div>
            <div id="profile-tools" class="tool-chips"></div>
            <p id="profile-reply" class="reply-text"></p>
        </section>

        <section class="surface timeline-card">
            <div class="section-heading compact">
                <div>
                    <span class="step-label">Memory store</span>
                    <h3>Retained memories</h3>
                </div>
                <button type="button" id="profile-refresh" class="secondary-action">
                    Refresh
                </button>
            </div>
            <p class="panel-note">
                Read from the memory tool's own output, not from the model's answer.
                This is the store's account of what it holds.
            </p>
            <ul id="profile-memories" class="memory-list">
                <li class="memory-empty">Not loaded yet.</li>
            </ul>
            <p id="profile-scope" class="memory-scope"></p>
        </section>
    </div>
</div>

@section Scripts {
<script>
(function () {
  const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
  const status = document.getElementById("profile-status");
  const notice = document.getElementById("profile-notice");
  const noticeText = document.getElementById("profile-notice-text");
  const box = document.getElementById("profile-message");
  const replyPanel = document.getElementById("reply-panel");
  const reply = document.getElementById("profile-reply");
  const tools = document.getElementById("profile-tools");
  const list = document.getElementById("profile-memories");
  const scope = document.getElementById("profile-scope");
  const send = document.getElementById("profile-send");
  const refresh = document.getElementById("profile-refresh");
  const clear = document.getElementById("profile-clear");
  const idle = status.textContent;
  const cards = document.querySelectorAll(".scenario-card");

  const deselect = () => cards.forEach((card) => {
    card.classList.remove("is-selected");
    card.setAttribute("aria-pressed", "false");
  });

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      deselect();
      card.classList.add("is-selected");
      card.setAttribute("aria-pressed", "true");
      box.value = card.dataset.prompt;
      box.focus();
    });
  });

  const fail = (message) => {
    noticeText.textContent = message;
    notice.hidden = false;
  };

  const busy = (on, message) => {
    [send, refresh].forEach((button) => { button.disabled = on; });
    clear.classList.toggle("is-disabled", on);
    status.textContent = message || idle;
  };

  const render = (data) => {
    const memories = data.memories || [];
    scope.textContent = data.scope
      ? "Scope " + data.scope + " \u2014 resolved by Foundry from the caller's Entra token."
      : "";
    list.innerHTML = "";
    if (memories.length === 0) {
      list.innerHTML = '<li class="memory-empty">Nothing retained.</li>';
      return;
    }
    memories.forEach((memory) => {
      const item = document.createElement("li");
      item.className = "memory-item";
      const kind = document.createElement("span");
      kind.className = "memory-kind";
      kind.textContent = memory.kind;
      const content = document.createElement("p");
      content.textContent = memory.content;
      item.append(kind, content);
      list.appendChild(item);
    });
  };

  const call = async (url, options, message) => {
    notice.hidden = true;
    busy(true, message);
    try {
      const response = await fetch(url, options);
      const data = await response.json().catch(() => ({}));
      busy(false, "");
      if (!response.ok) {
        fail(data.error || "The request failed.");
        return null;
      }
      return data;
    } catch {
      busy(false, "");
      fail("The profile agent could not be reached.");
      return null;
    }
  };

  const load = async () => {
    const data = await call("?handler=Memories", {}, "Reading the memory store\u2026");
    if (data) { render(data); }
  };

  send.addEventListener("click", async () => {
    const message = box.value.trim();
    if (!message) { fail("Enter a message first."); return; }
    const data = await call("?handler=Ask", {
      method: "POST",
      headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
      body: JSON.stringify({ message })
    }, "Asking the agent\u2026");
    if (!data) { return; }
    replyPanel.hidden = false;
    reply.textContent = data.text || "(no text returned)";
    tools.innerHTML = "";
    const used = data.toolsUsed || [];
    if (used.length === 0) {
      const chip = document.createElement("span");
      chip.className = "tool-chip tool-chip-none";
      chip.textContent = "no tools ran";
      tools.appendChild(chip);
    }
    used.forEach((tool) => {
      const chip = document.createElement("span");
      chip.className = "tool-chip";
      chip.textContent = tool;
      tools.appendChild(chip);
    });
    render(data);
  });

  refresh.addEventListener("click", load);

  clear.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!confirm("Delete every retained memory? This clears all scopes, including the one the CLI script uses.")) {
      return;
    }
    const data = await call("?handler=Clear", {
      method: "POST",
      headers: { "RequestVerificationToken": token }
    }, "Clearing the memory store\u2026");
    if (!data) { return; }
    list.innerHTML = '<li class="memory-empty">Nothing retained.</li>';
    scope.textContent = "";
    replyPanel.hidden = true;
    deselect();
    busy(false, "Memories cleared. Act 1 now starts from nothing.");
  });
})();
</script>
}

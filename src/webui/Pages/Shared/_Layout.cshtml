<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#081a20" />
    <title>@ViewData["Title"] · Northstar Banking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="page-shell header-inner">
            <a class="brand" asp-page="/Index" aria-label="Northstar Banking home">
                <span class="brand-mark">N</span>
                <span><strong>Northstar</strong><small>Banking operations</small></span>
            </a>
            <div class="environment-badge"><span></span> Secure workspace</div>
        </div>
    </header>

    <main class="page-shell">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="page-shell">
            <span>Northstar Banking Agent</span>
            <span>Human approval · Durable audit trail · Managed identity</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

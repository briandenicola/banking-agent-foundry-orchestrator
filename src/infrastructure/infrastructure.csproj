<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Foundry memory store APIs in Azure.AI.Projects are marked
         experimental (AAIP001), and the Responses-based chat client factory on
         Microsoft.Agents.AI.Foundry is marked MAAI001. Both remain
         experimental in their stable packages: a stable package is not the
         same thing as a stable API. See ADR 0003 and ADR 0007. -->
    <NoWarn>$(NoWarn);AAIP001;MAAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Referenced directly for AIProjectClient.MemoryStores. -->
    <PackageReference Include="Azure.AI.Projects" Version="2.0.0" />
    <!-- The orchestrator's own model access, for the harness agent (ADR 0007).
         1.5.0 is the newest *stable* release: this package went back to
         preview from 1.6.0 onward, so "latest" is the wrong choice here. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BankingAgent.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../application/application.csproj" />
    <ProjectReference Include="../domain/domain.csproj" />
  </ItemGroup>
</Project>
